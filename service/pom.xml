<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    为什么用 spring-boot-starter-parent 而不是自己管版本：
    Spring Boot 的依赖里有很多是"必须版本对齐"的（jackson / tomcat / spring-core）。
    自己管必然踩到 NoSuchMethodError 这类运行时才炸的坑。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.chenxinyu</groupId>
  <artifactId>docmind-service</artifactId>
  <version>0.1.0-phase4</version>
  <name>docmind-service</name>
  <description>DocMind Phase 4 minimal HTTP service bridging the resident Python worker</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      只引 web（内含 Spring MVC + 内嵌 Tomcat + Jackson）。
      刻意不引 webflux：SSE 用 spring-web 自带的 SseEmitter 就够了，
      再多引一套反应式栈既增大体积，也让"为什么会这样"变得难解释。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
